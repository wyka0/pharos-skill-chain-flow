# Pharos Skill Chain Flow - environment overrides
# This project is READ-ONLY. No private keys, seeds or API secrets are used or needed.

# Optional: override the Chain MCP endpoint used by the flow runner.
# Defaults come from config/profiles.json:
#   atlantic-testnet -> http://127.0.0.1:3001/mcp   (self-hosted official pharos-mcp)
#   hosted-mainnet   -> https://mcp.pharos.xyz/mcp  (official hosted endpoint)
# PHAROS_MCP_URL=http://127.0.0.1:3001/mcp

# Optional: override the profile name (atlantic-testnet | hosted-mainnet)
# PHAROS_MCP_PROFILE=atlantic-testnet

# Optional: where decision traces are written (default: demo/traces)
# TRACE_OUT_DIR=demo/traces

# Self-hosted Chain MCP settings used by scripts/chain-mcp.mjs (official pharos-mcp server)
# PHAROS_RPC_URL=https://atlantic.dplabs-internal.com
# PHAROS_CHAIN_ID=688689
# PHAROS_NATIVE_SYMBOL=PHRS
# MCP_HOST=127.0.0.1
# MCP_PORT=3001
